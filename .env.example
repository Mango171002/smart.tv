# Copy to .env.local for local development. NEVER commit real secrets.

# --- Public site configuration (placeholders until business decisions are made) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Brand is NOT decided. Leave empty to use the prototype placeholder "GlobalTV+".
NEXT_PUBLIC_BRAND_NAME=
# Keep false until launch: pages are served with noindex,nofollow.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Supabase (development project "Smart TV") ---
# Used server-side only (the browser never calls Supabase directly). The publishable
# key is protected by RLS + explicit grants; it is not a secret but stays server-side.
SUPABASE_URL=https://gsxgfefpkosrlflggdxv.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only secret key (service_role). Only needed for payment webhooks/orders.
# Leave empty in the prototype. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Features ---
# Contact / waitlist forms write to Supabase `contact_requests`.
FEATURE_CONTACT_FORM=true

# --- Commerce (LOCKED) ---
# Sales stay disabled whatever this value is, until every launch blocker in
# src/config/launch-gate.ts is resolved. Do not change without legal sign-off.
SALES_ENABLED=false
# Shared secret used to verify payment provider webhooks (HMAC-SHA256).
PAYMENT_WEBHOOK_SECRET=
