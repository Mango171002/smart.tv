# PRIVATE STAGING build settings (copied over .env.production by .github/workflows/deploy-staging.yml, in the
# workflow runner only). Next.js never loads this file by itself.
NEXT_PUBLIC_SITE_URL=https://staging.sygmatv.com
# Never indexable: robots.txt « Disallow: / », noindex on every page, X-Robots-Tag header.
NEXT_PUBLIC_ALLOW_INDEXING=false
# About us + Help center as they would be published (still noindex here).
NEXT_PUBLIC_CONTENT_PAGES=live
# French in preview mode (built, noindex), never released here.
NEXT_PUBLIC_SITE_MODE=preview
# No database, no contact form, no sales.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
FEATURE_CONTACT_FORM=false
SALES_ENABLED=false
