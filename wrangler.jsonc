{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Neutral technical name: the brand is not decided yet.
  "name": "iptv-international",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Custom domain bought on Cloudflare Registrar (sygmatv.com). The workers.dev URL keeps working.
  "routes": [
    { "pattern": "sygmatv.com", "custom_domain": true },
    { "pattern": "www.sygmatv.com", "custom_domain": true }
  ],
  // Non-secret runtime configuration. Secrets (SUPABASE_SECRET_KEY,
  // PAYMENT_WEBHOOK_SECRET) must be added with `wrangler secret put` — never here.
  "vars": {
    "SUPABASE_URL": "https://gsxgfefpkosrlflggdxv.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_9ToDpQ-FqIDKRHc7yindZA_uHKYes2P",
    "FEATURE_CONTACT_FORM": "true",
    "SALES_ENABLED": "false"
  }
}
